# Port du serveur Express
PORT=5000

# Base de données MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=salle_sport

# Secret JWT — OBLIGATOIRE. Générer avec : openssl rand -hex 32
JWT_SECRET=

# Origines autorisées par CORS (séparées par des virgules).
# Laisser vide en développement, OBLIGATOIRE en production.
# Exemple : CORS_ORIGIN=https://salle.mondomaine.com,https://admin.mondomaine.com
CORS_ORIGIN=

# Environnement : development | production | test
NODE_ENV=development
