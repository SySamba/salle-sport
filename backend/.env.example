# Port du serveur backend
PORT=5000

# Base de données MySQL (récupérez ces infos dans hPanel > Bases de données MySQL)
DB_HOST=localhost
DB_USER=votre_utilisateur_mysql
DB_PASSWORD=votre_mot_de_passe_mysql
DB_NAME=votre_base_de_donnees

# Clé secrète pour signer les tokens JWT.
# IMPORTANT : générez une chaîne longue et aléatoire pour la production.
# Exemple : openssl rand -hex 32
JWT_SECRET=changez_moi_par_une_cle_longue_et_aleatoire

# Origines autorisées pour CORS (séparées par des virgules).
# En production, mettez l'URL de votre frontend :
# CORS_ORIGIN=https://salle-sport.sambasy.com
CORS_ORIGIN=
